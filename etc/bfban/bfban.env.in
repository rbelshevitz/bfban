# Runtime configuration for bfband and the Fail2ban action.
BFBAN_BPFCLI=@PREFIX@/sbin/bfcli
BFBAN_BIN=@PREFIX@/sbin/bfban
BFBAN_DIRECT=auto
BFBAN_BPFFS=/sys/fs/bpf
BFBAN_SOCKET=/run/bfban/bfban.sock
BFBAN_DAEMON_STATE=/var/lib/bfban/daemon.state
BFBAN_STATE=/var/lib/bfban/banlist
BFBAN_CHAIN=bfban_input
BFBAN_HOOK=BF_HOOK_NF_LOCAL_IN{priorities=101-102}
